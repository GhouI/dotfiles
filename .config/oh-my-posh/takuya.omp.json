{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#8a4a1f",
          "foreground": "#ffffff",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "style": "diamond",
          "template": " {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#eea068",
          "foreground": "#fecb69",
          "options": {
            "root_icon": "\uf292"
          },
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \uf0e7 ",
          "type": "root"
        },
        {
          "background": "#2a211b",
          "foreground": "#f7e8d5",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "full"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#fecb69",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#fdd69f{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e2a88c{{ end }}",
            "{{ if gt .Ahead 0 }}#f2b880{{ end }}",
            "{{ if gt .Behind 0 }}#f2b880{{ end }}"
          ],
          "foreground": "#0c0805",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 "
          },
          "style": "powerline",
          "template": " {{ .HEAD }} {{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#eea068> \uf046 {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#2a211b",
          "foreground": "#3C873A",
          "leading_diamond": " \ue0b6",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#dd7f3f>\ue5fa</> ",
            "yarn_icon": " <#eea068>\ue6a7</>"
          },
          "style": "diamond",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": "\ue0b4",
          "type": "node"
        },
        {
          "background": "#8a4a1f",
          "foreground": "#ffffff",
          "invert_powerline": true,
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": " \ue641 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#eea068",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "#f7e8d5",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#eea068{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u276f ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
