configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  display-drun: "  apps";
  display-run: "  run";
  display-window: "  windows";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font Bold 12";
}

/* Crimson */
* {
  base:     #0d0405e6;
  surface0: #1d0a0c;
  surface1: #2b1013;
  text:     #f4dfe1;
  subtext0: #b8868c;
  mauve:    #e3122e;
  pink:     #f21956;

  background-color: transparent;
  text-color: @text;
}

window {
  width: 560px;
  background-color: @base;
  border: 2px solid;
  border-color: @mauve;
  border-radius: 16px;
  padding: 18px;
}

mainbox { spacing: 14px; children: [ inputbar, listview ]; }

inputbar {
  background-color: @surface0;
  border-radius: 12px;
  padding: 10px 14px;
  spacing: 10px;
  children: [ prompt, entry ];
}
prompt { text-color: @mauve; }
entry  { placeholder: "search..."; placeholder-color: @subtext0; }

listview { lines: 8; columns: 1; spacing: 4px; scrollbar: false; }

element {
  padding: 8px 12px;
  border-radius: 10px;
  spacing: 12px;
}
element-icon { size: 24px; }
element-text { vertical-align: 0.5; }
element normal.normal, element alternate.normal,
element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color: @text;
}
element selected.normal, element selected.active, element selected.urgent {
  background-color: @surface1;
  text-color: @pink;
}
element-icon, element-text { background-color: transparent; text-color: inherit; }
